{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
	  "source": "debian",
	  "color": { 
		  "2":"red"
	  }
    },
    "modules": [
	    "title",
	    "break",
	    {
		    "type": "os",
		    "key": "󰏝 OS",
		    "format": "{3}",
		    "keyColor": "yellow"
	    },
	    {
		    "type": "kernel",
		    "key": "󰀚 Kernel",
		    "format": "{2}",
		    "keyColor": "yellow"
        },
        {
            "type": "shell",
            "key": " Shell",
	    "format": "{1}",
            "keyColor": "yellow"
        },
        {
            "type": "uptime",
            "key": "󰅐 Uptime",
            "keyColor": "yellow"
        },
            "break",
        {
            "type": "wm",
            "key": "󰧨 Window Manager",
	    "format": "{1}",
            "keyColor": "cyan"
        },
        {
            "type": "wmtheme",
            "key": "󰉼 WM Theme",
            "keyColor": "cyan"
        },
        {
            "type": "theme",
            "key": "󰉼 Color Themes",
            "keyColor": "cyan"
        },
        {
            "type": "icons",
            "key": "󰸉 System Icons",
            "keyColor": "cyan"
        },
        {
            "type": "font",
            "key": " System Fonts",
            "keyColor": "cyan"
        },
        {
            "type": "terminal",
            "key": " Terminal",
	    "format": "{1}",
            "keyColor": "cyan"
        },
            "break",
        {
            "type": "host",
            "key": "󰌢 Host",
            "keyColor": "magenta"
        },
        {
            "type": "display",
            "key": "󰍹 Display",
            "keyColor": "magenta"
        },
        {
            "type": "cpu",
            "key": "󰻠 CPU",
	    "format": "{1}",
            "keyColor": "magenta",
            "temp": false,
            "freqNdigits": 1
        },
        {
            "type": "gpu",
            "key": "󰍛 GPU",
	    "format": "{3}",
            "keyColor": "magenta"
        },
        {
            "type": "disk",
            "key": " Disk",
            "keyColor": "magenta"
        },
	"break",
	{
		"type": "command",
		"key": "󰞆 CrowdSec",
		"text": "cscli alerts list --format json | jq '. | length'"
	}
  ]
}
