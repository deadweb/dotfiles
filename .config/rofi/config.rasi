configuration {
    modi: "drun,run,notification:~/.local/bin/rofi-notifications,wifi:~/.local/bin/rofi-wifi,bluethooth:~/.local/bin/rofi-bluetooth,power:~/.local/bin/rofi-power";
    show-icons: true;
    display-drun: "";
    display-run: " ";
    display-notification: "";
    display-wifi: "";
    display-bluethooth: "";
    display-power: "";
    sidebar-mode: true;
}

window {
    /* location 2 — це верх по центру */
    location:         2;
    anchor:           north;
    
    /* Відступ зверху: позитивне число опускає блок вниз */
    /* Спробуйте змінити 200 на 300 або 400, поки не стане як треба */
    y-offset:         1000px; 
    
    x-offset:         0;
    width:            600px;
}
