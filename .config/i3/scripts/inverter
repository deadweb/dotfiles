#!/usr/bin/env python3
import urllib.request
import urllib.parse
import json
import netrc
import os
import time

SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
STATE_FILE = os.path.join(SCRIPT_DIR, "soc.state")
BATTERY_CAPACITY_KWH = 5.0

def load_state():
    if os.path.exists(STATE_FILE):
        try:
            with open(STATE_FILE, "r") as f:
                data = json.load(f)
                return data.get("soc", 50.0), data.get("time", time.time())
        except Exception:
            pass
    return 50.0, time.time()

def save_state(soc, t):
    try:
        with open(STATE_FILE, "w") as f:
            json.dump({"soc": soc, "time": t}, f)
    except Exception:
        pass

def fetch_power():
    try:
        t, s, sa = netrc.netrc().authenticators("dessmonitor.com")
        p = {
            "action": "webQueryDeviceEnergyFlowEs",
            "source": "1",
            "devcode": "6514",
            "pn": "E50000253754058246",
            "devaddr": "1",
            "sn": "99532509100630",
            "token": t,
            "sign": s,
            "salt": sa
        }
        req = urllib.request.Request(
            "https://web.dessmonitor.com/public/?" + urllib.parse.urlencode(p),
            headers={"User-Agent": "i3blocks-script"}
        )
        with urllib.request.urlopen(req, timeout=3) as res:
            data = json.loads(res.read().decode())
            for k, lst in data.get("dat", {}).items():
                if isinstance(lst, list):
                    for i in lst:
                        if i.get("par") == "battery_active_power":
                            return float(i.get("val", 0))
    except Exception:
        pass
    return None

if __name__ == "__main__":
    current_soc, last_time = load_state()
    now = time.time()
    dt = (now - last_time) / 3600.0

    power = fetch_power()
    
    if power is not None and dt > 0:
        energy_change = power * dt
        soc_change = (energy_change / BATTERY_CAPACITY_KWH) * 100.0
        current_soc -= soc_change
        current_soc = max(0.0, min(100.0, current_soc))
        save_state(current_soc, now)

    color = "#FF5555" if (power is not None and power > 0) else "#55FF55"

    print(f"<span color='{color}'> {int(current_soc)}%</span>")
