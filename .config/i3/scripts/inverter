#!/usr/bin/env python3
import os
import requests
import netrc
import urllib.parse
import subprocess
from pathlib import Path
import datetime

# --- КОНФІГУРАЦІЯ ---
DEVICE_PARAMS = {
    "action": "webQueryDeviceEnergyFlowEs",
    "source": "1",
    "devcode": "6514",
    "pn": "E50000253754058246",
    "devaddr": "1",
    "sn": "99532509100630"
}

GRID_OFF_FLAG = Path("/tmp/inv_grid_off.flag")
GRID_OFF_COUNTER = Path("/tmp/inv_grid_off_counter.val")
LOG_FILE = Path.home() / ".local/bin/inverter_data.log"

def get_inverter_data():
    try:
        secrets = netrc.netrc().authenticators("dessmonitor.com")
        if not secrets: return None
        token, sign, salt = secrets
        
        params = {**DEVICE_PARAMS, "token": token, "sign": sign, "salt": salt}
        url = "https://web.dessmonitor.com/public/?" + urllib.parse.urlencode(params)
        
        r = requests.get(url, headers={"User-Agent": "Mozilla/5.0"}, timeout=10)
        data = r.json()
        
        if data.get("success") and "dat" in data:
            d = data["dat"]
            res = {"load_w": 0, "bat_p_w": 0, "soc": 0, "grid_p_w": 0, "grid_v": 0}

            all_items = d.get("bc_status", []) + d.get("bt_status", []) + d.get("gd_status", [])
            for item in all_items:
                p = item.get("par")
                v = item.get("val", 0)
                try: val_float = float(v)
                except: val_float = 0
                
                if p == "load_active_power":
                    res["load_w"] = abs(int(val_float * 1000))
                elif p == "battery_active_power":
                    res["bat_p_w"] = int(val_float * 1000)
                elif p == "bt_battery_capacity":
                    res["soc"] = int(val_float)
                elif p == "grid_active_power":
                    res["grid_p_w"] = int(val_float * 1000)
                elif p in ["grid_voltage", "grid_voltage_v", "ac_input_voltage"]:
                    res["grid_v"] = val_float
            return res
    except:
        return None
    return None

data = get_inverter_data()
if not data:
    exit()

# --- ЛОГІКА БЛЕКАУТУ З ГІСТЕРЕЗИСОМ ---
# Світла немає, якщо умови виконуються стабільно
is_grid_down_now = (data["grid_v"] < 40 and data["grid_p_w"] <= 5) and (data["bat_p_w"] < -10)

if GRID_OFF_COUNTER.exists():
    counter = int(GRID_OFF_COUNTER.read_text())
else:
    counter = 0

if is_grid_down_now:
    counter = min(counter + 1, 10) # Обмежуємо лічильник
else:
    counter = 0
GRID_OFF_COUNTER.write_text(str(counter))

# Сповіщення спрацьовує на 5-му циклі
if counter == 5:
    if not GRID_OFF_FLAG.exists():
        subprocess.run(["notify-send", "-u", "critical", "-a", "Inverter", "БЛЕКАУТ", "Мережа зникла. Робота від АКБ"])
        GRID_OFF_FLAG.touch()
elif counter == 0:
    if GRID_OFF_FLAG.exists():
        subprocess.run(["notify-send", "-a", "Inverter", "МЕРЕЖА OK", "Світло з'явилося"])
        GRID_OFF_FLAG.unlink(missing_ok=True)

# Визначаємо статус для i3bar, спираючись на прапорець (Flag), а не на миттєве значення
is_grid_down = GRID_OFF_FLAG.exists()

# --- ЗАПИС ЛОГУ ---
try:
    now = datetime.datetime.now().strftime("%H:%M:%S")
    log_line = f"{now} {data['load_w']} {data['soc']} {data['bat_p_w']} {data['grid_p_w']}\n"
    with open(LOG_FILE, "a") as f:
        f.write(log_line)
    
    if LOG_FILE.exists():
        with open(LOG_FILE, "r") as f:
            lines = f.readlines()
        if len(lines) > 1440:
            with open(LOG_FILE, "w") as f:
                f.writelines(lines[-1440:])
except:
    pass

# --- ОБРОБКА КЛІКУ (i3blocks) ---
if os.environ.get("BLOCK_BUTTON") == "1":
    status_text = "Відсутня" if is_grid_down else f"{data.get('grid_v', 0)}V (Спож: {data['grid_p_w']}W)"
    msg = (f"🏠 Навантаження: {data['load_w']} W\n"
           f"🔋 Батарея: {data['soc']}% ({data['bat_p_w']} W)\n"
           f"⚡ Мережа: {status_text}")
    subprocess.run(["notify-send", "-a", "Inverter", "Монітор інвертора", msg])

# --- ВИВІД ДЛЯ i3bar ---
icon = ""
if data["bat_p_w"] < -10: 
    color = "#FF3300" # Розряд
    status = f" <span color='{color}'>{data['load_w']}W (↓{abs(data['bat_p_w'])}W)</span>"
elif data["bat_p_w"] > 10:
    color = "#FFFF00" # Заряд
    status = f" <span color='{color}'>{data['load_w']}W (↑{data['bat_p_w']}W)</span>"
else:
    color = "#00BFFF" if not is_grid_down else "#FF3300"
    status = f" <span color='#FFFFFF'>{data['load_w']}W</span>"

print(f"<span color='{color}' font='FontAwesome'>{icon}</span>{status}")
print(icon)
